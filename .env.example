# Copiar a .env para cambiar valores (cp .env.example .env).
# Todos tienen un valor por defecto en docker-compose.yml, así que .env es opcional.
# Solo para desarrollo local: no usar estas credenciales fuera de este entorno.

# Base de datos
# Usuario, contraseña y nombre de la base. La aplicación usa los mismos valores.
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo_dev
POSTGRES_DB=catalogo
# Puerto de la base en esta máquina (solo 127.0.0.1). Cambiarlo si el 5432 está ocupado.
DB_PORT=5432

# Aplicación
# Puerto de la aplicación en esta máquina: http://localhost:3000
APP_PORT=3000
# Máximo de filas que acepta la carga de un archivo CSV.
MAX_FILAS_CSV=100
