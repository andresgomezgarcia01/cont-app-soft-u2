# Copiar a .env para cambiar valores (cp .env.example .env).
# Todos tienen un valor por defecto en docker-compose.yml, así que .env es opcional.
# Solo para desarrollo local: no usar estas credenciales fuera de este entorno.

# Base de datos
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo_dev
POSTGRES_DB=catalogo

# API
API_PORT=8080
MAX_BATCH_SIZE=100

# Frontend
WEB_PORT=3000
