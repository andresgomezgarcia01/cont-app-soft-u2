
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error <%= codigo %> | Catálogo de aplicaciones</title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <header class="encabezado">
    <h1>Error <%= codigo %></h1>
    <p>No fue posible completar la solicitud.</p>

    <nav class="navegacion" aria-label="Navegación principal">
      <a href="/aplicaciones">Catálogo</a>
      <a href="/carga">Carga masiva</a>
    </nav>
  </header>

  <main class="contenedor">
    <section class="panel">
      <h2>¿Qué ocurrió?</h2>
      <p role="alert"><%= mensaje %></p>
      <p>Verifica la dirección o regresa al catálogo para continuar.</p>
      <a class="boton" href="/aplicaciones">Volver al catálogo</a>
    </section>
  </main>
</body>
</html>
