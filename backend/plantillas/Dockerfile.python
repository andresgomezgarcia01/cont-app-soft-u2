# Plantilla: backend en Python (por ejemplo, FastAPI con uvicorn) y psycopg.
# Uso: cp backend/plantillas/Dockerfile.python backend/Dockerfile
#
# Supone requirements.txt en backend/ y la aplicación en app/main.py, con el
# objeto "app" (AJUSTAR "app.main:app" si es otro). uvicorn escucha en 0.0.0.0
# y en el puerto de la variable PORT (ver backend/README.md).

# --- Etapa 1: dependencias en un entorno virtual ------------------------------
FROM python:3.13-slim AS deps
WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# --- Etapa final -----------------------------------------------------------------
FROM python:3.13-slim
LABEL org.opencontainers.image.title="catalogo-api"
# PYTHONUNBUFFERED: los logs salen al instante por la salida estándar.
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=deps /opt/venv /opt/venv
COPY . .
RUN useradd --system --uid 10001 app
USER app
EXPOSE 8080
# sh -c solo para leer PORT; "exec" deja a uvicorn como proceso principal, así
# recibe SIGTERM directamente (docker stop).
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
